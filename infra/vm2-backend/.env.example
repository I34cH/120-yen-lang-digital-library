# Copy thành infra/vm2-backend/.env trên VM 2 (KHÔNG commit file .env lên Git)
APP_ENV=production
APP_NAME=University Digital Library API

# Trỏ tới PostgreSQL trên VM 3 qua mạng nội bộ
DATABASE_URL=postgresql+psycopg://library_user:CHANGE_ME@<VM3_IP>:5432/digital_library

# Trỏ tới Object Storage (MinIO) trên VM 3 qua mạng nội bộ
STORAGE_ENDPOINT=http://<VM3_IP>:9000
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME
STORAGE_BUCKET=digital-library-files

# Chỉ cho phép origin của VM 1 hoặc domain chính thức
CORS_ORIGINS=http://<VM1_IP>,https://<YOUR_DOMAIN>
